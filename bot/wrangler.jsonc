{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guu-schedule-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // сайт мини-приложения: оттуда же бот берёт schedule.json и overrides.json
    "WEBAPP_URL": "https://kkreal75-droid.github.io/guu-schedule/",
    // имя бота — для ссылок t.me/<бот>/schedule (проверяется в GET / через getMe)
    "BOT_USERNAME": "GUU_Scheduule_bot",
    // «Обновить сейчас» в админ-панели запускает этот workflow (нужен секрет GITHUB_TOKEN)
    "GITHUB_REPO": "kkreal75-droid/guu-schedule",
    "GITHUB_WORKFLOW": "deploy.yml"
  },
  // D1 — всё, что часто пишется: пользователи, визиты, рассылки (миграции — в migrations/)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guu-bot",
      "database_id": "b21fb0f4-bb06-4c28-b639-0c21d88e4750",
      "migrations_dir": "migrations"
    }
  ],
  // KV — редкие записи: настройки. (Namespace называется STATS: раньше там была статистика,
  // теперь она в D1.)
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "bb0c6081b6c441e7ac3c52afeb245b45"
    }
  ],
  // раз в минуту: досылает рассылки пачками (лимит 50 подзапросов на вызов)
  "triggers": { "crons": ["* * * * *"] },
  // логи воркера видны в панели Cloudflare и в `npx wrangler tail`
  "observability": { "enabled": true }
}
