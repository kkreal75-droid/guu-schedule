{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // worker-configuration.d.ts генерирует `npx wrangler types` (типы рантайма и привязок)
  "include": ["src", "../shared", "worker-configuration.d.ts"]
}
